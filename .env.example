APP_NAME="MoneyUnify Switch"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DOCS_ONLY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI features (optional). Server-wide fallback; accounts add their own providers on the AI & Agents page. See /docs/ai-and-mcp.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# PayPal MCP fallback for accounts without a PayPal provider (optional). Use https://mcp.paypal.com/http for live.
MCP_PAYPAL_URL=https://mcp.sandbox.paypal.com/http
MCP_PAYPAL_TOKEN=

# Payment gateway waits, in seconds: connect fails fast, then wait up to 3 minutes for an answer.
# Raise your web server's limits (nginx fastcgi_read_timeout, php-fpm request_terminate_timeout) to match.
GATEWAY_CONNECT_TIMEOUT=8
GATEWAY_TIMEOUT=180
# PayPal can be slow to connect from some networks; a call that never connected moved no money.
PAYPAL_CONNECT_TIMEOUT=20

# Optional: your PayPal sandbox app, added to the demo account by `composer setup --demo-data`.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# FX for cross-border payments: a static sandbox rate table, a margin, and how long quotes are locked.
FX_DRIVER=static
FX_MARGIN_PERCENT=1.5
FX_QUOTE_TTL_MINUTES=10

# Spending caps on cross-border transfers, in USD (merchant payments use only the per-transfer cap).
TRANSFER_MAX_PER_TRANSACTION_USD=2000
TRANSFER_MAX_DAILY_USD=5000

# Optional: the average cost of sending money to your corridors today, in percent (e.g. the
# World Bank Remittance Prices Worldwide figure for your region), shown against your merchants' cost.
IMPACT_BENCHMARK_COST_PERCENT=
