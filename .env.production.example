# Production settings for `docker compose -f compose.prod.yaml`.
# Copy this file to .env.production (never commit it) and fill it in.
# Guide: prezet/content/docker-production.md

# Your domain, pointed at this server (DNS A/AAAA record), and its https URL.
APP_DOMAIN=pay.example.com
APP_URL=https://pay.example.com
APP_NAME="MoneyUnify Switch"

# Required secrets. Generate them on the server:
#   APP_KEY:     echo "base64:$(openssl rand -base64 32)"
#   DB_PASSWORD: openssl rand -hex 24
# Keep APP_KEY safe and never change it: it encrypts saved provider and AI keys.
APP_KEY=
DB_PASSWORD=

# Email (sign-up verification, password resets, receipts). Any SMTP provider.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=payments@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Sessions, cache and queue (Redis is installed and configured with native keepalive on port 6379).
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TCP_KEEPALIVE=60
REDIS_PERSISTENT=true

# Spending limits for cross-border transfers (USD).
TRANSFER_MAX_PER_TRANSACTION_USD=2000
TRANSFER_MAX_DAILY_USD=5000

# Optional server-wide AI fallback. Each account normally adds its own AI
# provider, model and key on the AI & Agents page instead.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Payment providers (PayPal live, payout providers) are added in the app on
# the Providers page, not here.
