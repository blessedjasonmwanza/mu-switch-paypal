# Optional settings for `docker compose up`. Copy this file to .env.docker and
# fill in what you have; everything else works without it.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Added to the demo account when it's created; or add PayPal on Providers.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# pawaPay sandbox token for real sandbox payouts. Without it, payouts use
# Simulated Payouts.
PAWAPAY_SANDBOX_TOKEN=

# Server-wide AI fallback for the Send Money assistant. Any supported provider
# works; you can also add providers, models and keys on the AI & Agents page.
AI_PROVIDER=gemini
GEMINI_API_KEY=
